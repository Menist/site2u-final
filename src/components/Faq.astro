---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<section class="faq">
  <h2 class="block-heading">Частые вопросы</h2>

  <div class="faq__card card">
    <div class="faq__content" aria-live="polite" aria-atomic="true">
      {items.map((item, index) => (
          <div class="faq__item" data-faq-item aria-hidden={index === 0 ? 'false' : 'true'} class:list={['faq__item', { 'is-active': index === 0 }]}>
            <h3 class="faq__question">{item.question}</h3>
            <p class="faq__answer">{item.answer}</p>
          </div>
      ))}
    </div>

    <div class="faq__controls">
      <button class="faq__btn" data-faq-prev aria-label="Предыдущий вопрос">←</button>
      <span class="faq__counter" data-faq-counter>1 / {items.length}</span>
      <button class="faq__btn" data-faq-next aria-label="Следующий вопрос">→</button>
    </div>
  </div>
</section>
<script>
  let currentIndex = 0;
  let isTransitioning = false;

  const itemEls = document.querySelectorAll<HTMLElement>('[data-faq-item]');
  const counterEl = document.querySelector<HTMLElement>('[data-faq-counter]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-faq-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-faq-next]');
  const total = itemEls.length;

  if (!counterEl || !prevBtn || !nextBtn || !total) {
    // Элементы не найдены на странице — дальше делать нечего
  } else {
    function render(direction: number, previousIndex: number) {
      isTransitioning = true;

      const prevEl = itemEls[previousIndex];
      const nextEl = itemEls[currentIndex];

      prevEl.style.transform = `translateX(${direction * -30}px)`;
      prevEl.classList.remove('is-active');
      prevEl.setAttribute('aria-hidden', 'true');

      nextEl.style.transform = `translateX(${direction * 30}px)`;

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          nextEl.classList.add('is-active');
          nextEl.setAttribute('aria-hidden', 'false');
          nextEl.style.transform = 'translateX(0)';
          counterEl!.textContent = `${currentIndex + 1} / ${total}`;
        });
      });

      setTimeout(() => {
        prevEl.style.transform = '';
        isTransitioning = false;
      }, 300);
    }

    // Единственное место, где навешаны обработчики клика — без дублирования.
    // Проверка isTransitioning стоит ДО мутации currentIndex, чтобы быстрый повторный
    // клик во время анимации не мог рассинхронизировать состояние.
    nextBtn.addEventListener('click', () => {
      if (isTransitioning) return;
      const previousIndex = currentIndex;
      currentIndex = (currentIndex + 1) % total;
      render(1, previousIndex);
    });

    prevBtn.addEventListener('click', () => {
      if (isTransitioning) return;
      const previousIndex = currentIndex;
      currentIndex = (currentIndex - 1 + total) % total;
      render(-1, previousIndex);
    });
  }
</script>
<style>
  .faq {
    max-width: var(--container-sm);
  }
  .faq__content {
    position: relative;
    display: grid;
  }

  .faq__item {
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .faq__item.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  .faq__card {
    padding: var(--space-lg);
    text-align: center;
    overflow: hidden;
  }

  .faq__content {
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .faq__question {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-sm);
    transition: color 0.3s ease;
  }

  .faq__answer {
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-md);
    transition: color 0.3s ease;
  }

  .faq__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }

  .faq__btn {
    font-family: var(--font-family-base);
    width: 36px;
    height: 36px;
    border-radius: var(--radius-circle);
    background: var(--color-accent);
    color: var(--color-text-primary);
    font-weight: var(--font-weight-bold);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-bg), transform 0.2s ease;
    cursor: pointer;
    border: none;
    user-select: none;
  }

  .faq__btn:hover {
    background: var(--color-accent-hover);
    transform: scale(1.05);
  }

  .faq__btn:active {
    transform: scale(0.95);
  }

  .faq__counter {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    min-width: 40px;
    transition: color 0.3s ease;
  }


  /* ==========================================================================
   АДАПТИВНАЯ ВЕРСТКА: faq
   ========================================================================== */

  /* ===== Планшеты (до 992px) ===== */
  @media (max-width: 992px) {
    .faq {
      max-width: 100%;
      padding: 0 var(--space-sm);
    }

    .faq__card {
      padding: var(--space-lg);
    }

    .faq__question {
      font-size: var(--font-size-md);
    }

    .faq__answer {
      font-size: var(--font-size-base);
    }
  }

  /* ===== Мобильные (до 768px) ===== */
  @media (max-width: 768px) {
    .faq {
      padding: 0;
    }

    .faq__card {
      padding: var(--space-md);
      border-radius: var(--radius-sm);
    }

    .faq__question {
      font-size: var(--font-size-base);
      margin-bottom: var(--space-xs);
      line-height: var(--line-height-tight);
    }

    .faq__answer {
      font-size: var(--font-size-sm);
      margin-bottom: var(--space-md);
      line-height: var(--line-height-relaxed);
    }

    .faq__controls {
      gap: var(--space-sm);
    }

    .faq__btn {
      width: 44px;
      height: 44px;
      font-size: var(--font-size-md);
      min-height: var(--touch-target-min);
      min-width: var(--touch-target-min);
    }

    .faq__counter {
      font-size: var(--font-size-sm);
      min-width: 50px;
    }
  }

  /* ===== Маленькие телефоны (до 480px) ===== */
  @media (max-width: 480px) {
    .faq__card {
      padding: var(--space-sm);
    }

    .faq__question {
      font-size: var(--font-size-sm);
      margin-bottom: 6px;
    }

    .faq__answer {
      font-size: var(--font-size-xs);
      margin-bottom: var(--space-sm);
      line-height: var(--line-height-loose);
    }

    .faq__controls {
      gap: var(--space-xs);
    }

    .faq__btn {
      width: 40px;
      height: 40px;
      font-size: var(--font-size-sm);
      min-height: 40px;
      min-width: 40px;
    }

    .faq__btn:hover {
      transform: none;
    }

    .faq__counter {
      font-size: var(--font-size-xs);
      min-width: 44px;
    }
  }

  /* ===== Очень узкие экраны (до 360px) ===== */
  @media (max-width: 360px) {
    .faq__card {
      padding: var(--space-xs);
    }

    .faq__question {
      font-size: var(--font-size-xs);
      margin-bottom: 4px;
    }

    .faq__answer {
      font-size: 12px;
      margin-bottom: var(--space-xs);
    }

    .faq__btn {
      width: 36px;
      height: 36px;
      font-size: var(--font-size-xs);
      min-height: 36px;
      min-width: 36px;
    }

    .faq__counter {
      font-size: 11px;
      min-width: 38px;
    }
  }
</style>