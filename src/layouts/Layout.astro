---
import '@fontsource/open-sans/300.css';
import '@fontsource/open-sans/600.css';
import '@fontsource/open-sans/700.css';
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
import fontBoldUrl from "@fontsource/open-sans/files/open-sans-cyrillic-700-normal.woff2?url";
import fontLightUrl from "@fontsource/open-sans/files/open-sans-cyrillic-300-normal.woff2?url";
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "site2u.by",
  "url": "https://site2u.by/",
  "logo": "https://site2u.by/android-chrome-512x512.png",
  "telephone": "+375293195265",
  "email": "imc@imc.by",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "пр. Независимости, д. 68-2, к.108",
    "addressLocality": "Минск",
    "addressCountry": "BY"
  },
  "sameAs": [
    "https://t.me/imc_by"
  ]
};

interface Props {
  title: string;
  description: string;
  serviceSchema?: object;
  transparent?: boolean
  bodyClass?: string
}

const { title, description, serviceSchema, transparent = false, bodyClass = '' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);



---
<html lang="ru">
<head>
  <meta charset="UTF-8"/>
  <!-- 1. Кодировка — всегда первой -->
  <script is:inline>
    document.documentElement.classList.add('js-loading');
  </script>
  <!-- 2. Viewport -->
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  {bodyClass === 'is-home' && (
      <link
          rel="preload"
          as="image"
          href="/images/hero-bg-1280.webp"
          imagesrcset="
    /images/hero-bg-640.webp 640w,
    /images/hero-bg-960.webp 960w,
    /images/hero-bg-1280.webp 1280w,
    /images/hero-bg-1920.webp 1920w,
    /images/hero-bg-2560.webp 2560w
  "
          imagesizes="100vw"
          fetchpriority="high"
      />
  )}


  <link rel="preload" as="font" type="font/woff2" href={fontLightUrl} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={fontBoldUrl} crossorigin />
  <style is:global>
    .js-loading .services,
    .js-loading .about-teaser,
    .js-loading .advantages,
    .js-loading .not-doing,
    .js-loading .process,
    .js-loading .configurator,
    .js-loading .our-approach,
    .js-loading .cta {
      opacity: 0 !important;
      transform: translateY(35px) !important;
    }
  </style>

  <!-- 5. Title и мета -->
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta name="generator" content={Astro.generator}/>
  <meta name="google-site-verification" content="xTSWs3ffQhgcm-tiYO9HUXO1Qh3iPW0TaNlNgdw703U" />
  <meta name="yandex-verification" content="ad8369549c1620cd" />

  <!-- 6. Canonical и OG -->
  <link rel="canonical" href={canonicalURL}/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonicalURL}/>
  <meta property="og:image" content={ogImageURL}/>
  <meta property="og:type" content="website"/>
  <meta property="og:locale" content="ru_RU"/>
  <meta property="og:site_name" content="site2u.by"/>

  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={ogImageURL}/>

  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

  <!-- 7. Фавиконки -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/>
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"/>
  <link rel="icon" href="/favicon.ico"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
  <link rel="manifest" href="/site.webmanifest"/>

  <!-- 8. Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}/>
  {serviceSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}/>
  )}

  <!-- 9. CSS -->
  <link rel="stylesheet" href="/animations.css"/>

  <!-- 10. Скрипты defer -->
  <script defer src="/animations.js"></script>
  <script defer src="/validation.js"></script>

  <!-- 11. Аналитика (последней, через idle) -->
  <script is:inline>
    function loadAnalytics() {
      // Google Analytics
      const gaScript = document.createElement('script');
      gaScript.async = true;
      gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-9EL42XVXEB';
      document.head.appendChild(gaScript);
      gaScript.onload = function () {
        window.dataLayer = window.dataLayer || [];

        function gtag() {
          dataLayer.push(arguments);
        }

        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-9EL42XVXEB');
      };

      // Яндекс.Метрика
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () {
          (m[i].a = m[i].a || []).push(arguments)
        };
        m[i].l = 1 * new Date();
        k = e.createElement(t), a = e.getElementsByTagName(t)[0], k.async = 1, k.src = r, a.parentNode.insertBefore(k, a)
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=110113534', 'ym');
      ym(110113534, 'init', {
        ssr: true,
        webvisor: true,
        clickmap: true,
        accurateTrackBounce: true,
        trackLinks: true
      });
    }

    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadAnalytics);
    } else {
      setTimeout(loadAnalytics, 2000);
    }
  </script>

  <!-- 12. Трекинг кликов -->
  <script is:inline>
    document.addEventListener('click', function (e) {
      const target = e.target.closest('[data-track]');
      if (!target) return;

      const eventName = target.dataset.track;

      if (typeof gtag !== 'undefined') {
        gtag('event', eventName, {
          event_category: 'click',
          event_label: target.textContent.trim()
        });
      }

      if (typeof ym !== 'undefined') {
        ym(110113534, 'reachGoal', eventName);
      }
    });
  </script>
</head>
<body class={bodyClass}>
<noscript>
  <div><img src="https://mc.yandex.ru/watch/110113534" style="position:absolute;left:-9999px;" alt=""/></div>
</noscript>

<Header transparent={transparent} isHome={bodyClass === 'is-home'}/>
<main>
  <slot/>
</main>
<Footer/>

</body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
  }


  @media (max-width: 768px) {
    html,
    body {
      min-height: 100vh;
      min-height: 100dvh;
    }
  }
</style>